<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/overlay_bar_bg"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Poignée de déplacement (maintener du doigt) -->
    <TextView
        android:id="@+id/handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="≡"
        android:textColor="#AAFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="6dp" />

    <HorizontalScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/tabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Mode diffusion : propage les taps sur toutes les instances -->
    <TextView
        android:id="@+id/btnBroadcast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡"
        android:textSize="15sp"
        android:padding="8dp"
        android:layout_marginStart="4dp" />

    <!-- Replier la barre en bulle -->
    <TextView
        android:id="@+id/btnMin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="–"
        android:textColor="#CCFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <!-- Fermer complètement la barre -->
    <TextView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✕"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:padding="8dp"
        android:layout_marginEnd="4dp" />
</LinearLayout>
